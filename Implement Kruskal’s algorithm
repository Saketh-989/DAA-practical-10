
def kruskal(n, edges):
    parent = list(range(n))
    rank = [0] * n

    def find(x):
        if parent[x] != x:
            parent[x] = find(parent[x])
        return parent[x]

    def union(x, y):
        root_x = find(x)
        root_y = find(y)

        if root_x == root_y:
            return False

        if rank[root_x] < rank[root_y]:
            parent[root_x] = root_y
        elif rank[root_x] > rank[root_y]:
            parent[root_y] = root_x
        else:
            parent[root_y] = root_x
            rank[root_x] += 1

        return True

    edges.sort(key=lambda edge: edge[2])

    total_cost = 0
    count = 0

    print("Minimum Spanning Tree:")

    for u, v, weight in edges:
        if union(u, v):
            print(u, "-", v, ":", weight)
            total_cost += weight
            count += 1

            if count == n - 1:
                break

    if count != n - 1:
        print("Graph is disconnected; MST cannot be formed.")
    else:
        print("Total cost of MST:", total_cost)


n = int(input("Enter number of vertices: "))
e = int(input("Enter number of edges: "))

edges = []

print("Enter edges as: source destination weight")
for i in range(e):
    u, v, w = map(int, input().split())
    edges.append((u, v, w))

kruskal(n, edges)

